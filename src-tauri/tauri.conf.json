{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YT Download",
  "version": "0.1.1-rc.2",
  "identifier": "com.ytdownload.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YT Download",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http: https: data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost ws://localhost:1420; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/deno"
    ],
    "windows": { "nsis": { "displayLanguageSelector": false } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1MTE0RDI5QTM4RjU0QUEKUldTcVZJK2pLVTBSSmYyckhMUGEyaDE3Zm9LcGdvUzZzNlo0K3ZwTDFYZmZuYWVGN3ZvNHBydFgK",
      "endpoints": ["https://github.com/Lucasleiva1/youtube-descarga/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
